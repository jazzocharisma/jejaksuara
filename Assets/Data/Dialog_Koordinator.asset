  m_Script: {fileID: 11500000, guid: 6c2ff12cca391054d8396c9c88780a13, type: 3}
  m_Name: Dialog_Koordinator
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  npcName: Koordinator Lapangan
  effectsOnlyOnce: 1
  nodes:
  - text: Halo Bro. Ingat kan kalau hari ini kita mau turun ke jalan? Sudah paham
      tujuan aksinya?
    choices:
    - text: Paham. Kita akan menyuarakan tuntutan bersama.
      nextNode: 1
      barChange: 5
      relationChange: 1
    - text: AKu ikut aja. Nanti juga tahu.
      nextNode: 2
      barChange: -5
      relationChange: 0
    - text: Tuntutannya apa saja ya?
      nextNode: 3
      barChange: 5
      relationChange: 0
    nextNode: 0
  - text: Bagus. Ingat, aksi kita tertib dan tanpa kekerasan. Bantu kumpulkan teman-temanmu
      ya.
    choices: []
    nextNode: -1
  - text: Hmm, sebaiknya pahami dulu. Kita bergerak karena tuntutan yang jelas, bukan
      ikut-ikutan.
    choices: []
    nextNode: -1
  - text: Pertanyaan bagus. Tuntutannya dirumuskan di rapat konsolidasi nanti. Ikutlah
      supaya paham.
    choices: []
    nextNode: -1
